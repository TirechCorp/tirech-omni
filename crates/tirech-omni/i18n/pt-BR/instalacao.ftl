# Instalar no computador (M65): erros das operações de instalação.
instalacao-erro-em-uso = O app está rodando da cópia instalada; ela só pode ser apagada pela desinstalação.
instalacao-erro-sem-copia = Esse item precisa da cópia instalada. Marque também "Copiar para o computador".
instalacao-erro-sem-pasta = Não foi possível achar a pasta de instalação ou o executável do app.
instalacao-erro-sem-area = Este ambiente não tem pasta da área de trabalho.
instalacao-erro-painel = Este ambiente não deixa o app fixar sozinho no painel.
instalacao-erro-sem-bundle = O app não está rodando de dentro de um pacote .app.
instalacao-erro-json = Não foi possível editar a configuração do painel: { $erro }

# O diálogo "Instalar no computador" (M65).
instalar-titulo = Instalar no computador
instalar-titulo-desinstalar = Desinstalar do computador
instalar-introducao = Escolha o que o { -app } deixa neste computador. Cada item é aplicado à parte: se um falhar, os outros seguem.
instalar-introducao-desinstalar = O que estiver desmarcado é removido deste computador.
instalar-aplicar = Aplicar
instalar-aplicando = Aplicando…
instalar-desinstalar = Desinstalar…
instalar-apagar-dados = Apagar também os meus dados (conexões, cofre, notas, logs)
instalar-apagar-dados-pasta = Pasta de dados: { $pasta }
instalar-confirmar-titulo = Apagar os seus dados?
instalar-confirmar-texto = As conexões, o cofre, as notas e os logs de { $pasta } serão apagados e não voltam. O app fecha em seguida.
instalar-confirmar-apagar = Apagar tudo e desinstalar

# Os itens.
instalar-item-copia = Copiar para o computador
instalar-item-area = Atalho na área de trabalho
instalar-item-menu-windows = Atalho no menu Iniciar
instalar-item-menu-linux = Atalho no menu de aplicativos
instalar-item-barra-windows = Fixar na barra de tarefas
instalar-item-barra-linux = Fixar no painel
instalar-item-barra-macos = Manter no Dock
instalar-inicio-na-bandeja = Ficar só na bandeja, sem abrir a janela
instalar-item-inicio = Abrir com o sistema
instalar-item-aplicativos = Aparecer em Aplicativos instalados

# O que cada item mostra embaixo do nome, quando não é um caminho.
instalar-desc-registro = Registro do Windows: { $chave }
instalar-desc-barra-windows = O Windows só deixa a própria pessoa fixar; o app mostra o passo.
instalar-desc-barra-painel = Painel do { $painel }
instalar-desc-barra-dock = Dock do macOS
instalar-desc-copia-em-uso = Esta é a cópia que está aberta agora.

# Por que um item não dá agora.
instalar-motivo-sem-area = Este ambiente não tem pasta de área de trabalho.
instalar-motivo-precisa-da-copia = Precisa da cópia no computador.
instalar-motivo-painel = Este ambiente não deixa o app fixar sozinho; arraste o { -app } do menu para o painel.
instalar-motivo-sem-bundle = Só funciona com o app aberto de dentro do pacote .app.
instalar-motivo-barra-precisa-do-menu = Fixar precisa do atalho no menu.

# O resultado.
instalar-resultado-titulo-ok = Instalação aplicada
instalar-resultado-titulo-aviso = Alguns itens não foram aplicados
instalar-resultado-ok = O que você escolheu foi aplicado.
instalar-resultado-nada = Nada a fazer: o computador já está como você pediu.
instalar-resultado-falha = { $item }: { $erro }
instalar-passo-fixar-windows = Para fixar na barra de tarefas: abra o menu Iniciar, ache o { -app }, clique com o botão direito e escolha Fixar na barra de tarefas.
instalar-passo-fixar-windows-depois = Para fixar na barra de tarefas: abra a versão instalada, clique com o botão direito no ícone dela na barra e escolha Fixar na barra de tarefas.
instalar-passo-desafixar-windows = Para tirar da barra de tarefas: clique com o botão direito no ícone e escolha Desafixar da barra de tarefas.
instalar-passo-dock = Para tirar do Dock: arraste o ícone do { -app } para fora dele.
instalar-abrir-copia = Abrir a versão instalada
instalar-erro-abrir-copia = Não foi possível abrir a versão instalada: { $erro }
instalar-erro-desinstalar = Não foi possível agendar a remoção das pastas: { $erro }

# O resumo da página de Configurações.
instalar-resumo-instalado = Instalado em { $pasta }
instalar-resumo-parcial = Instalado em parte
instalar-resumo-nao = Não instalado
